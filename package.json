{
  "name": "@effectified/engine",
  "version": "0.1.0",
  "description": "The effectified engine: analyzes a library's types and source, drafts a recipe, generates an Effect-native facade, and keeps it in step with upstream",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effectified/engine.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "bin": {
    "effectify": "./bin/effectify.js"
  },
  "files": [
    "bin",
    "dist",
    "src/runtime",
    "README.md"
  ],
  "scripts": {
    "effectify": "node src/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ast-grep/napi": "0.51.3",
    "@effect/platform-node": "4.1.5",
    "effect": "4.1.5",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@2fd1a57",
    "@effect/vitest": "4.1.5",
    "@types/node": "26.6.7",
    "vitest": "5.1.1"
  }
}
